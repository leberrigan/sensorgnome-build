# Create ARMv7 bookworm image for RaspberryPi Sensorgnome

FROM images/base-$TYPE.img
TO images/sg-$TYPE-temp.img

PUMP 4000M

# Create data directories, these will be copied to the new partition on first boot
mkdir -p /data/SGdata
date >/data/SGdata/created

# Change the pi user to 'gnome', can't use userconf-pi inside this docker env
NU=gnome
RUN usermod -l $NU pi
RUN usermod -m -d /home/$NU $NU
RUN groupmod -n $NU pi
RUN sed -i -e "s/^pi:/$NU:/" /etc/subuid
RUN sed -i -e "s/^pi:/$NU:/" /etc/subgid
RUN chpasswd -e <<<$NU:x
RUN systemctl disable userconfig
RUN systemctl enable getty@tty1
RUN rm /usr/share/userconf-pi/sshd_banner
RUN bash -c '(echo; echo export SYSTEMD_LESS=XRF) >> /home/$NU/.bashrc'

# Raspberry Pi OS apt sources use raspbian.raspberrypi.com (CDN) and a mirror://
# mirror-list protocol entry pointing to mirrors.raspbian.org. From GitHub Actions
# (US IP), both route to mirror.umd.edu which is unreachable. Replace the CDN URL
# with archive.raspbian.org (canonical primary archive, not CDN), remove the mirror://
# entry (redundant once we have a direct URL), and remove any remaining mirror.umd.edu
# lines that may have crept in from other configs.
RUN bash -c "find /etc/apt -name '*.list' | xargs sed -i \
    -e 's|raspbian.raspberrypi.com/raspbian|archive.raspbian.org/raspbian|g' \
    -e '/mirrors.raspbian.org/d' \
    -e '/mirror.umd.edu/d' \
    2>/dev/null; true"

# Re-fetch all three Debian Bookworm signing keys so the sg build is self-contained
# and doesn't depend on the base image having the correct keyring. The base image may
# be cached from before the 3-key fix was applied.
# rm -f first: gpg refuses to overwrite an existing keyring file (exits "File exists")
# which breaks the curl pipe before any data is read. options=mr: machine-readable
# format returns raw ASCII armor, not HTML.
RUN bash -c "rm -f /usr/share/keyrings/debian-bookworm-archive-keyring.gpg && \
    (curl -fsSL 'https://keyserver.ubuntu.com/pks/lookup?op=get&search=0x6ED0E7B82643E131&options=mr'; \
     curl -fsSL 'https://keyserver.ubuntu.com/pks/lookup?op=get&search=0x78DBA3BC47EF2265&options=mr'; \
     curl -fsSL 'https://keyserver.ubuntu.com/pks/lookup?op=get&search=0xF8D2585B8783D481&options=mr') \
    | gpg --batch --no-tty --dearmor -o /usr/share/keyrings/debian-bookworm-archive-keyring.gpg"

# Configure sensorgnome repository
RUN bash -c "curl -1sLf -o /usr/share/keyrings/sensorgnome.gpg 'https://sensorgnome-982081078525-us-east-1-an.s3.us-east-1.amazonaws.com/sensorgnome.gpg'"
RUN gpg --no-default-keyring --keyring /usr/share/keyrings/sensorgnome.gpg --list-keys
RUN bash -c "echo 'deb [signed-by=/usr/share/keyrings/sensorgnome.gpg] https://sensorgnome-982081078525-us-east-1-an.s3.us-east-1.amazonaws.com/' $CODENAME main >/etc/apt/sources.list.d/sensorgnome.list"
RUN apt update

# Install GNU Radio runtime components directly, bypassing the 'gnuradio' metapackage
# which hard-depends on PyQt5, python3-opengl, libjs-mathjax, a terminal emulator, etc.
# (all needed for GRC companion, none needed for headless Python flow graphs).
# -t bookworm forces apt to resolve all packages and their deps (libgfortran5, liblapack3,
# etc.) from deb.debian.org, bypassing the Raspbian CDN that routes to mirror.umd.edu.
RUN apt-get install -y --no-install-recommends -t bookworm \
    libgnuradio-runtime3.10.5 \
    libgnuradio-filter3.10.5 \
    libgnuradio-blocks3.10.5 \
    libgnuradio-audio3.10.5 \
    libgnuradio-soapy3.10.5 \
    libgnuradio-fft3.10.5 \
    gr-osmosdr \
    python3-numpy python3-scipy python3-sklearn
RUN apt-get clean

# python3-gnuradio is only in Debian Bookworm, not Raspbian. Now that the Debian
# Bookworm keyring is set up above and apt update has run, apt-get download can find
# it. Using apt-get download (no dep check) avoids the version conflict with Raspbian's
# libgnuradio-runtime3.10.5; dpkg -x extracts the Python files only.
RUN bash -c "cd /var/tmp && apt-get download python3-gnuradio && dpkg -x python3-gnuradio_*.deb py-gr && cp -r py-gr/usr/lib/python3/dist-packages/. /usr/lib/python3/dist-packages/ && rm -rf py-gr python3-gnuradio_*.deb"

# Build libairspyhf and the SoapySDR AirspyHF plugin from source.
# libairspyhf0 has no armhf build in Raspbian or Debian main repos.
# We build both the C library and the SoapySDR plugin (needed by gr_airspyhf.py),
# then register a dummy libairspyhf0 .deb with dpkg so that apt can satisfy
# sensorgnome-gnuradio's Depends: libairspyhf0 when it installs below.
RUN apt install -y cmake libusb-1.0-0-dev libsoapysdr-dev

RUN git clone --depth=1 --branch v1.1.5 https://github.com/airspy/airspyhf.git /tmp/airspyhf && \
    cmake -S /tmp/airspyhf -B /tmp/airspyhf/build \
          -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release && \
    cmake --build /tmp/airspyhf/build -j2 && \
    cmake --install /tmp/airspyhf/build

RUN git clone --depth=1 https://github.com/pothosware/SoapyAirspyHF.git /tmp/SoapyAirspyHF && \
    cmake -S /tmp/SoapyAirspyHF -B /tmp/SoapyAirspyHF/build \
          -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release && \
    cmake --build /tmp/SoapyAirspyHF/build -j2 && \
    cmake --install /tmp/SoapyAirspyHF/build

RUN bash -c "mkdir -p /tmp/pkg/DEBIAN && \
    printf 'Package: libairspyhf0\nVersion: 1.1.5-sg\nArchitecture: armhf\nDepends: libusb-1.0-0\nMaintainer: Sensorgnome\nDescription: AirspyHF+ USB library (built from source)\n' \
        > /tmp/pkg/DEBIAN/control && \
    dpkg-deb -Zxz --build /tmp/pkg /tmp/libairspyhf0.deb && \
    dpkg --install /tmp/libairspyhf0.deb"

RUN rm -rf /tmp/airspyhf /tmp/SoapyAirspyHF /tmp/pkg /tmp/libairspyhf0.deb

# Install sensorgnome packages (the has-double line can be deleted when no pre 2023-080 SG exists)
RUN dpkg --print-architecture
RUN mkdir -p /opt/sensorgnome/upgrader
RUN touch /opt/sensorgnome/upgrader/has-double
RUN apt install -y sensorgnome
RUN mkdir -p /etc/sensorgnome
RUN apt-get clean

# local-ip.co cert download disabled: service is serving mismatched key/cert pairs (broken)
# The stable release has an old working cert baked in from before it broke.
# If local-ip.co fixes their cert rotation, re-enable these lines and add the sed below.
#RUN curl -L -o /etc/sensorgnome/local-ip.key http://local-ip.co/cert/server.key
#RUN curl -L -o /etc/sensorgnome/local-ip.pem http://local-ip.co/cert/server.pem
#RUN bash -c 'curl -L -o - http://local-ip.co/cert/chain.pem >>/etc/sensorgnome/local-ip.pem'
#RUN bash -c 'chmod 644 /etc/sensorgnome/local-ip.*'
#RUN openssl x509 -noout -enddate -in /etc/sensorgnome/local-ip.pem
#RUN sed -i 's|self-signed.pem|local-ip.pem|; s|self-signed.key|local-ip.key|' /etc/caddy/Caddyfile

# Install some python packages for sixfab stuff
#RUN pip3 install -U atcom pyyaml pyusb smbus2 crc16
RUN pip3 install -U --break-system-packages atcom

# Enable SSH (0 == success status code - enable)
RUN raspi-config nonint do_ssh 0

# Set swapfile size to 500MB
RUN sed -i -e 's/SWAPSIZE=100/SWAPSIZE=500/' /etc/dphys-swapfile

# Disable some log files so everything doesn't get logged 3 times... Focus on /var/log/syslog
# RUN bash -c 'sed -i -e "/^daemon/d" -e "/^\*\.=info;/,+3d" /etc/rsyslog.conf' # FIXME!
RUN rm -rf /var/log/journal
RUN bash -c "echo 'RuntimeMaxUse=1M' >> /etc/systemd/journald.conf"

# Change logrotate config so old log files get a date extension to make it easier to sync them
# to the hub
RUN bash -c 'sed -i -e "s/weekly/daily/" -e "/rotate/s/4/60/" /etc/logrotate.d/rsyslog'
RUN sed -i 's/endscript/endscript\n\tdateext\n\tdateyesterday\n\tnodelaycompress/' /etc/logrotate.d/rsyslog

# Enable I2C (setting '0' = on !?!?)
RUN raspi-config nonint do_i2c 0

# Set UTC timezone
RUN ln -sf /usr/share/zoneinfo/UTC /etc/localtime

# Reboot on kernel panic
RUN tee -a /etc/sysctl.conf <<<kernel.panic=10

# Quiet down rngd logging
RUN bash -c 'echo RNGDOPTIONS="--stats-interval=86400" >>/etc/default/rng-tools-debian'

# Prevent resizing of root partition on first boot. This allows us to create a data
# partition. The PUMP statement above creates a large enough root partition.
# Commands copied from /usr/lib/raspi-config/init_resize.sh
RUN sed -i 's| init=\S*||' /boot/firmware/cmdline.txt
RUN sed -i 's| sdhci\.debug_quirks2=4||' /boot/firmware/cmdline.txt
RUN sed -i "s/ quiet//g" /boot/firmware/cmdline.txt
RUN sed -i 's/^auto_initramfs=1/auto_initramfs=0/' /boot/firmware/config.txt
RUN rm /etc/rc3.d/S01resize2fs_once

# Change the avahi/bonjour/mDNS hostname to sgpi.local and enable advertising
RUN bash -c 'sed -ir -e "/host-name/s/.*/host-name=sgpi/" -e "/publish-workstation/s/no/yes/" /etc/avahi/avahi-daemon.conf'

# Pre-generate self-signed TLS cert so caddy can start on first boot before sg-web-portal runs.
# init-config.sh will regenerate a fresh cert on first boot anyway.
RUN bash -c 'openssl req -x509 -newkey rsa:2048 -days 3650 -noenc -keyout /etc/sensorgnome/self-signed.key -out /etc/sensorgnome/self-signed.pem -subj "/CN=sgpi.local" -addext "subjectAltName=DNS:sgpi.local,DNS:*.sgpi.local" && chmod 644 /etc/sensorgnome/self-signed.*'

# Timestamp the Sensorgnome image so we can detect and unset clock
RUN bash -c 'date +%s >/etc/sensorgnome/image-stamp'

# Write build version to /etc/sensorgnome/version (always overwrite so image version is accurate)
RUN bash -c "echo 'sg-$TYPE-$V' >/etc/sensorgnome/version"

# Create SD card identification file on boot partition (FAT32, Windows-readable).
# Device ID and boot count are appended on first boot by sg-boot/boottime.sh.
RUN bash -c 'printf "%s\n%s UTC\n" "$(cat /etc/sensorgnome/version)" "$(date -u -d @$(cat /etc/sensorgnome/image-stamp) +%Y-%m-%d %H:%M)" >/boot/firmware/SENSORGNOME.txt'
